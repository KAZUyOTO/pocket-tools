{
  "name": "pocket-tools",
  "version": "0.1.0",
  "description": "Self-hosted, fully open-source file conversion service. Upload a file, pick a format, get it back. Powered by ffmpeg, LibreOffice, ImageMagick, pandoc and friends.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker.js"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "bullmq": "^6.3.17",
    "fastify": "^5.2.0",
    "ioredis": "^6.0.0",
    "nanoid": "^5.0.9"
  }
}
